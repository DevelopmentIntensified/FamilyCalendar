<script lang="ts">
	import { createEventDispatcher } from 'svelte';
	import type { Event } from '$lib/types';
	import LocationSearch from '$lib/components/LocationSearch.svelte';
	import { DateTime } from 'luxon';

	export let show = false;
	export let event: Event | null = null;
	export let calendarIds: { id: string; name: string }[] = [];
	export let familyMembers: { userId: string; firstName: string; lastName: string; email: string }[] = [];
	export let rsvpData: { userId: string; status: string; firstName?: string; lastName?: string }[] = [];

	const dispatch = createEventDispatcher();

	let nlInput = '';
	let title = '';
	let date = ''; // date only: "YYYY-MM-DD"
	let startTime = ''; // time only: "HH:MM"
	let endTime = ''; // time only: "HH:MM"
	let allDay = false;
	let multiDay = false;
	let endDate = ''; // date only for multi-day events
	let end = ''; // datetime-local format: "YYYY-MM-DDTHH:mm"
	let location = '';
	let description = '';
	let selectedCalendarId = '';
	let attendants: string[] = []; // array of user IDs
	let newAttendant = ''; // for non-user attendants
	let recentAttendants: string[] = []; // recent non-user attendants from past events
	let showMore = false; // toggle for show more/less
	let showMoreAttendants = false; // toggle for attendants section
	let parsing = false;
	let parseTimeout: ReturnType<typeof setTimeout>;

	$: isEditMode = event !== null;
	$: showNlInput = !isEditMode;

	// Populate form when editing
	$: if (event) {
		title = event.title || '';
		if (event.start) {
			const dt = DateTime.fromISO(event.start);
			date = dt.toFormat("yyyy-MM-dd");
			startTime = dt.toFormat("HH:mm");
		}
		if (event.end) {
			const dt = DateTime.fromISO(event.end);
			endTime = dt.toFormat("HH:mm");
		}
		location = event.location || '';
		description = event.description || '';
		selectedCalendarId = event.calendarId || (calendarIds.length > 0 ? calendarIds[0].id : '');
	} else {
		selectedCalendarId = calendarIds.length > 0 ? calendarIds[0].id : '';
	}

	// NLP parsing with debounce
	async function parseNlInput() {
		if (!nlInput.trim()) return;
		
		parsing = true;
		try {
			const response = await fetch('/api/parse-event', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ input: nlInput })
			});
			
			if (response.ok) {
				const parsed = await response.json();
				if (parsed.title) title = parsed.title;
				if (parsed.dateTime) {
					const dt = DateTime.fromISO(parsed.dateTime);
					start = dt.toFormat("yyyy-MM-dd'T'HH:mm");
				}
				if (parsed.endDateTime) {
					const dt = DateTime.fromISO(parsed.endDateTime);
					end = dt.toFormat("yyyy-MM-dd'T'HH:mm");
				}
				if (parsed.location) location = parsed.location;
				description = nlInput;
			}
		} catch (error) {
			console.error('Parse error:', error);
		} finally {
			parsing = false;
		}
	}

	function onNlInputChange() {
		clearTimeout(parseTimeout);
		parseTimeout = setTimeout(() => parseNlInput(), 1000);
	}

	function close() {
		show = false;
		dispatch('close');
	}

	function handleSubmit(e: SubmitEvent) {
		e.preventDefault();

		// Combine date + startTime into start timestamp
		let startTimestamp = '';
		if (date && startTime) {
			startTimestamp = DateTime.fromFormat(`${date} ${startTime}`, "yyyy-MM-dd HH:mm").toISO();
		} else if (date) {
			startTimestamp = DateTime.fromFormat(date, "yyyy-MM-dd").toISO();
		}

		// Combine date (or endDate if multi-day) + endTime into end timestamp
		let endTimestamp = null;
		if (multiDay && endDate && endTime) {
			endTimestamp = DateTime.fromFormat(`${endDate} ${endTime}`, "yyyy-MM-dd HH:mm").toISO();
		} else if (multiDay && endDate) {
			endTimestamp = DateTime.fromFormat(endDate, "yyyy-MM-dd").toISO();
		} else if (!multiDay && date && endTime) {
			endTimestamp = DateTime.fromFormat(`${date} ${endTime}`, "yyyy-MM-dd HH:mm").toISO();
		} else if (!multiDay && date) {
			endTimestamp = DateTime.fromFormat(date, "yyyy-MM-dd").toISO();
		}

		const eventData = {
			title,
			start: startTimestamp,
			end: endTimestamp,
			location,
			description,
			calendarId: selectedCalendarId
		};

		if (isEditMode && event) {
			dispatch('update', { id: event.id, ...eventData });
		} else {
			dispatch('create', eventData);
		}
	}

	function handleDelete() {
		if (event) dispatch('delete', { id: event.id });
	}

	function clearDetected() {
		title = '';
		start = '';
		end = '';
		location = '';
		description = '';
		nlInput = '';
	}
</script>

{#if show}
	<!-- Modal Backdrop with blur -->
	<div
		class="fixed inset-0 z-50 flex items-center justify-center bg-black/40 backdrop-blur-sm"
		on:click={close}
		on:keydown={(e) => e.key === 'Escape' && close()}
		role="presentation"
	>
		<!-- Modal Panel with slide-up animation -->
		<div
			class="w-full max-w-lg transform rounded-2xl bg-white shadow-2xl transition-all duration-300 ease-out"
			on:click|stopPropagation
			on:keydown|stopPropagation
			role="dialog"
			aria-modal="true"
			aria-labelledby="modal-title"
		>
			<!-- Header with gradient -->
			<div class="relative overflow-hidden bg-gradient-to-r from-primary-600 to-primary-700 px-6 py-5">
				<div class="flex items-center justify-between">
					<h2 id="modal-title" class="text-xl font-bold text-white">
						{isEditMode ? '✏️ Edit Event' : '✨ Create Event'}
					</h2>
					<button
						on:click={close}
						class="rounded-full p-2 text-white/80 transition-colors hover:bg-white/20 hover:text-white"
						aria-label="Close modal"
					>
						<svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
							<path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
						</svg>
					</button>
				</div>
				{#if !isEditMode}
					<p class="mt-1 text-sm text-white/70">Quick-add with natural language</p>
				{/if}
			</div>

			<form on:submit={handleSubmit}>
				<div class="space-y-5 p-6">
					<!-- NL Input (create mode) -->
					{#if showNlInput}
						<div class="group relative">
							<div class="pointer-events-none absolute inset-y-0 left-3 flex items-center">
								<svg class="h-4 w-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
									<path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
								</svg>
							</div>
							<input
								type="text"
								bind:value={nlInput}
								on:input={onNlInputChange}
								placeholder="Try: Lunch Friday at noon with John in Conference A"
								class="w-full rounded-xl border border-slate-200 bg-slate-50 py-3 pl-10 pr-4 text-sm transition-all focus:border-primary-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-primary-500/20"
							/>
							{#if parsing}
								<div class="absolute right-3 top-1/2 -translate-y-1/2">
									<div class="h-4 w-4 animate-spin rounded-full border-2 border-primary-600 border-t-transparent"></div>
								</div>
							{/if}
						</div>
					{/if}

					<!-- Title -->
					<div class="group">
						<label for="event-title" class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-slate-500">Title</label>
						<div class="relative">
							<div class="pointer-events-none absolute inset-y-0 left-3 flex items-center">
								<svg class="h-4 w-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
									<path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
								</svg>
							</div>
							<input
								id="event-title"
								type="text"
								name="title"
								bind:value={title}
								placeholder="Event title"
								required
								class="w-full rounded-xl border border-slate-200 bg-slate-50 py-3 pl-10 pr-4 text-sm transition-all focus:border-primary-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-primary-500/20"
							/>
						</div>
					</div>

					<!-- Date & Time Grid -->
					<div class="grid grid-cols-2 gap-4">
						<!-- Date -->
						<div class="group">
							<label for="event-date" class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-slate-500">Date</label>
							<div class="relative">
								<div class="pointer-events-none absolute inset-y-0 left-3 flex items-center">
									<svg class="h-4 w-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
										<path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
									</svg>
								</div>
								<input
									id="event-date"
									type="date"
									name="date"
									bind:value={date}
									required
									class="w-full rounded-xl border border-slate-200 bg-slate-50 py-3 pl-10 pr-4 text-sm transition-all focus:border-primary-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-primary-500/20"
								/>
							</div>
						</div>

						<!-- Start Time (hidden when all-day) -->
						<div class="group" class:hidden={allDay}>
							<label for="start-time" class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-slate-500">Start</label>
							<div class="relative">
								<div class="pointer-events-none absolute inset-y-0 left-3 flex items-center">
									<svg class="h-4 w-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
										<path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6l4 2m6-2a8 8 0 11-16 0 8 8 0 0116 0z" />
									</svg>
								</div>
								<input
									id="start-time"
									type="time"
									name="startTime"
									bind:value={startTime}
									class="w-full rounded-xl border border-slate-200 bg-slate-50 py-3 pl-10 pr-4 text-sm transition-all focus:border-primary-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-primary-500/20"
								/>
							</div>
						</div>
					</div>

					<!-- All-Day & Multi-Day Row -->
					<div class="grid grid-cols-2 gap-4">
						<!-- All-Day Checkbox -->
						<div class="flex items-center justify-between rounded-xl bg-slate-50 px-4 py-3">
							<div class="flex items-center gap-2">
								<svg class="h-4 w-4 text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
									<path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.996 3.996 12 10c0 1.657-1.343 3-3 3s-3-1.343-3-3 1.343-3 3-3 3 1.343 3 3c0 1.657 1.343 3 3 3z" />
								</svg>
								<label for="all-day" class="text-sm font-medium text-slate-700">All-day</label>
							</div>
							<input
								type="checkbox"
								id="all-day"
								bind:checked={allDay}
								class="h-5 w-5 rounded border-2 border-slate-300 text-primary-600 focus:ring-primary-500"
							/>
						</div>

						<!-- Multi-Day Checkbox -->
						<div class="flex items-center justify-between rounded-xl bg-slate-50 px-4 py-3">
							<div class="flex items-center gap-2">
								<svg class="h-4 w-4 text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
									<path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
								</svg>
								<label for="multi-day" class="text-sm font-medium text-slate-700">Multi-day</label>
							</div>
							<input
								type="checkbox"
								id="multi-day"
								bind:checked={multiDay}
								class="h-5 w-5 rounded border-2 border-slate-300 text-primary-600 focus:ring-primary-500"
							/>
						</div>
					</div>

					<!-- End Date (only if multi-day) -->
					{#if multiDay}
						<div class="group">
							<label for="end-date" class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-slate-500">End Date</label>
							<div class="relative">
								<div class="pointer-events-none absolute inset-y-0 left-3 flex items-center">
									<svg class="h-4 w-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
										<path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
									</svg>
								</div>
								<input
									id="end-date"
									type="date"
									name="endDate"
									bind:value={endDate}
									class="w-full rounded-xl border border-slate-200 bg-slate-50 py-3 pl-10 pr-4 text-sm transition-all focus:border-primary-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-primary-500/20"
								/>
							</div>
						</div>
					{/if}

					<!-- Location -->
					<div class="group">
						<label for="event-location" class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-slate-500">Location</label>
						<div class="relative">
							<div class="pointer-events-none absolute inset-y-0 left-3 flex items-center">
								<svg class="h-4 w-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
									<path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
									<path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
								</svg>
							</div>
							<div class="pl-10">
								<LocationSearch bind:value={location} />
							</div>
						</div>
					</div>

					<!-- Description -->
					<div class="group">
						<label for="event-desc" class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-slate-500">Description</label>
						<textarea
							id="event-desc"
							bind:value={description}
							placeholder="Details..."
							rows="3"
							class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm transition-all focus:border-primary-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-primary-500/20 resize-none"
						></textarea>
					</div>

					<!-- Calendar Selector -->
					{#if calendarIds.length > 1}
						<div class="group">
							<label for="event-calendar" class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-slate-500">Calendar</label>
							<select
								id="event-calendar"
								bind:value={selectedCalendarId}
								class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm transition-all focus:border-primary-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-primary-500/20"
							>
								{#each calendarIds as cal}
									<option value={cal.id}>{cal.name}</option>
								{/each}
							</select>
						</div>
					{/if}

					<!-- Show More/Less Button -->
					<button
						type="button"
						on:click={() => showMore = !showMore}
						class="flex w-full items-center justify-center gap-1 rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm font-medium text-slate-600 transition-all hover:bg-slate-100"
					>
						{showMore ? 'Show Less' : 'Show More'}
						<svg
							class="h-4 w-4 transition-transform {showMore ? 'rotate-180' : ''}"
							fill="none"
							viewBox="0 0 24 24"
							stroke="currentColor"
							stroke-width="2"
						>
							<path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
						</svg>
					</button>

					<!-- More Fields (hidden by default) -->
					{#if showMore}
						<!-- Location -->
						<div class="group">
							<label for="event-location" class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-slate-500">Location</label>
							<div class="relative">
								<div class="pointer-events-none absolute inset-y-0 left-3 flex items-center">
									<svg class="h-4 w-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
										<path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
										<path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
									</svg>
								</div>
								<div class="pl-10">
									<LocationSearch bind:value={location} />
								</div>
							</div>
						</div>

						<!-- Description -->
						<div class="group">
							<label for="event-desc" class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-slate-500">Description</label>
							<textarea
								id="event-desc"
								bind:value={description}
								placeholder="Add details..."
								rows="3"
								class="w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm transition-all focus:border-primary-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-primary-500/20 resize-none"
							></textarea>
						</div>

						<!-- Attendants Section -->
						<div class="rounded-xl border border-slate-200 bg-slate-50 p-4">
							<div class="mb-3 flex items-center justify-between">
								<label class="text-xs font-semibold uppercase tracking-wide text-slate-500">Attendants</label>
								<button
									type="button"
									on:click={() => showMoreAttendants = !showMoreAttendants}
									class="text-xs font-medium text-primary-600 hover:text-primary-700"
								>
									{showMoreAttendants ? 'Hide' : 'Show'} Attendants
								</button>
							</div>

							{#if showMoreAttendants}
								<!-- Family Members Multi-select -->
								{#if familyMembers.length > 0}
									<div class="mb-3 max-h-32 overflow-y-auto rounded-lg border border-slate-200 bg-white">
										{#each familyMembers as member}
											<button
												type="button"
												on:click={() => {
													if (attendants.includes(member.userId)) {
														attendants = attendants.filter(id => id !== member.userId);
													} else {
														attendants = [...attendants, member.userId];
													}
												}}
												class="flex w-full items-center gap-2 px-3 py-2 text-left text-sm hover:bg-slate-50 {attendants.includes(member.userId) ? 'bg-primary-50 text-primary-700' : ''}"
											>
												<input
													type="checkbox"
													checked={attendants.includes(member.userId)}
													readonly
													class="rounded border-slate-300"
												/>
												{member.firstName} {member.lastName}
											</button>
										{/each}
									</div>
								{/if}

								<!-- Recent Non-user Attendants -->
								{#if recentAttendants.length > 0}
									<div class="mb-3">
										<p class="mb-1 text-xs text-slate-500">Recent:</p>
										<div class="flex flex-wrap gap-1">
											{#each recentAttendants as att}
												<button
													type="button"
													on:click={() => {
														if (!attendants.includes(att)) {
															attendants = [...attendants, att];
														}
													}}
													class="rounded-full bg-slate-200 px-2 py-1 text-xs hover:bg-slate-300"
												>
													{att}
												</button>
											{/each}
										</div>
									</div>
								{/if}

								<!-- Non-user Attendant Input -->
								<div class="flex gap-2">
									<input
										type="text"
										bind:value={newAttendant}
										placeholder="Add non-user attendant..."
										class="flex-1 rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm focus:border-primary-500 focus:outline-none"
									/>
									<button
										type="button"
										on:click={() => {
											if (newAttendant.trim()) {
												attendants = [...attendants, newAttendant.trim()];
												newAttendant = '';
											}
										}}
										class="rounded-lg bg-slate-200 px-3 py-2 text-sm font-medium hover:bg-slate-300"
									>
										Add
									</button>
								</div>

								<!-- Selected Attendants Chips -->
								{#if attendants.length > 0}
									<div class="mt-3 flex flex-wrap gap-1">
										{#each attendants as att}
											<span class="inline-flex items-center gap-1 rounded-full bg-primary-100 px-2 py-1 text-xs text-primary-700">
												{att}
												<button
													type="button"
													on:click={() => attendants = attendants.filter(a => a !== att)}
													class="ml-1 text-primary-500 hover:text-primary-700"
												>
													×
												</button>
											</span>
										{/each}
									</div>
								{/if}
							{/if}
						</div>
					{/if}
				</div>
						</div>
					{/if}

					<!-- Title -->
					<div class="group">
						<label for="event-title" class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-slate-500">Title</label>
						<div class="relative">
							<div class="pointer-events-none absolute inset-y-0 left-3 flex items-center">
								<svg class="h-4 w-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
									<path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
								</svg>
							</div>
							<input
								id="event-title"
								type="text"
								name="title"
								bind:value={title}
								placeholder="Event title"
								required
								class="w-full rounded-xl border border-slate-200 bg-slate-50 py-3 pl-10 pr-4 text-sm transition-all focus:border-primary-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-primary-500/20"
							/>
						</div>
					</div>

				<!-- Date (applies to both start and end) -->
				<div>
					<label for="event-date" class="block text-sm font-medium text-slate-700 mb-1">Date</label>
					<input
						id="event-date"
						type="date"
						name="date"
						bind:value={date}
						required
						class="w-full rounded-lg border border-slate-200 px-3 py-2.5 text-sm focus:border-primary-500 focus:outline-none"
					/>
				</div>

				<!-- Time Section with All-Day -->
				<div class="grid grid-cols-2 gap-4">
					<!-- Start Time -->
					<div class="group" class:hidden={allDay}>
						<label for="start-time" class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-slate-500">Start Time</label>
						<div class="relative">
							<div class="pointer-events-none absolute inset-y-0 left-3 flex items-center">
								<svg class="h-4 w-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
									<path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6l4 2m6-2a8 8 0 11-16 0 8 8 0 0116 0z" />
								</svg>
							</div>
							<input
								id="start-time"
								type="time"
								name="startTime"
								bind:value={startTime}
								class="w-full rounded-xl border border-slate-200 bg-slate-50 py-3 pl-10 pr-4 text-sm transition-all focus:border-primary-400 focus:bg-white focus:ring-2 focus:ring-primary-500/20"
							/>
						</div>
					</div>

					<!-- End Time -->
					<div class="group" class:hidden={allDay}>
						<label for="end-time" class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-slate-500">End Time</label>
						<div class="relative">
							<div class="pointer-events-none absolute inset-y-0 left-3 flex items-center">
								<svg class="h-4 w-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
									<path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-1a8 8 0 11-16 0 8 8 0 0116 0z" />
								</svg>
							</div>
							<input
								id="end-time"
								type="time"
								name="endTime"
								bind:value={endTime}
								class="w-full rounded-xl border border-slate-200 bg-slate-50 py-3 pl-10 pr-4 text-sm transition-all focus:border-primary-400 focus:bg-white focus:ring-2 focus:ring-primary-500/20"
							/>
						</div>
					</div>
				</div>

				<!-- All-Day Checkbox -->
				<div class="flex items-center justify-between rounded-xl bg-slate-50 px-4 py-3">
					<div class="flex items-center gap-2">
						<svg class="h-5 w-5 text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
							<path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.996 3.996 12 10c0 1.657-1.343 3-3 3s-3-1.343-3-3 1.343-3 3-3 3 1.343 3 3c0 1.657 1.343 3 3 3z" />
						</svg>
						<label for="all-day" class="text-sm font-medium text-slate-700">All-day event</label>
					</div>
					<input
						type="checkbox"
						id="all-day"
						bind:checked={allDay}
						class="h-5 w-5 rounded border-2 border-slate-300 text-primary-600 focus:ring-primary-500"
					/>
				</div>

				<!-- Multi-day Checkbox -->
				<div class="flex items-center justify-between rounded-xl bg-slate-50 px-4 py-3">
					<div class="flex items-center gap-2">
						<svg class="h-5 w-5 text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
							<path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
						</svg>
						<label for="multi-day" class="text-sm font-medium text-slate-700">Multi-day event</label>
					</div>
					<input
						type="checkbox"
						id="multi-day"
						bind:checked={multiDay}
						class="h-5 w-5 rounded border-2 border-slate-300 text-primary-600 focus:ring-primary-500"
					/>
				</div>

				<!-- End Time (optional) -->
				<div>
					<label class="block text-sm font-medium text-slate-700 mb-1">End Time (optional)</label>
					<input
						type="time"
						name="endTime"
						bind:value={endTime}
						class="w-full rounded-lg border border-slate-200 px-3 py-2.5 text-sm focus:border-primary-500 focus:outline-none"
					/>
				</div>

				<!-- Multi-day Checkbox -->
				<div class="flex items-center gap-2">
					<input
						type="checkbox"
						id="multi-day"
						bind:checked={multiDay}
						class="rounded border-slate-300 text-primary-600 focus:ring-primary-500"
					/>
					<label for="multi-day" class="text-sm text-slate-700">Multi-day event</label>
				</div>

				<!-- End Date (only if multi-day) -->
				{#if multiDay}
					<div>
						<label for="end-date" class="block text-sm font-medium text-slate-700 mb-1">End Date</label>
						<input
							id="end-date"
							type="date"
							name="endDate"
							bind:value={endDate}
							class="w-full rounded-lg border border-slate-200 px-3 py-2.5 text-sm focus:border-primary-500 focus:outline-none"
						/>
					</div>
				{/if}

					<!-- Location -->
					<div>
						<label class="block text-sm font-medium text-slate-700 mb-1">Location</label>
						<LocationSearch bind:value={location} />
					</div>

					<!-- Description -->
					<div>
						<label class="block text-sm font-medium text-slate-700 mb-1">Description</label>
						<textarea
							bind:value={description}
							placeholder="Details..."
							rows="3"
							class="w-full rounded-lg border border-slate-200 px-3 py-2.5 resize-none text-sm focus:border-primary-500 focus:outline-none"
						></textarea>
					</div>

				<!-- Calendar Selector -->
				{#if calendarIds.length > 1}
					<div>
						<label class="block text-sm font-medium text-slate-700 mb-1">Calendar</label>
						<select
							bind:value={selectedCalendarId}
							class="w-full rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-sm"
						>
							{#each calendarIds as cal}
								<option value={cal.id}>{cal.name}</option>
							{/each}
						</select>
					</div>
				{/if}

				<!-- Attendants Section -->
				<div>
					<label class="block text-sm font-medium text-slate-700 mb-2">Attendants</label>

					<!-- Family Members Multi-select -->
					{#if familyMembers.length > 0}
						<div class="mb-2 max-h-32 overflow-y-auto rounded-lg border border-slate-200 bg-white">
							{#each familyMembers as member}
								<button
									type="button"
									on:click={() => {
										if (attendants.includes(member.userId)) {
											attendants = attendants.filter(id => id !== member.userId);
										} else {
											attendants = [...attendants, member.userId];
										}
									}}
									class="flex w-full items-center gap-2 px-3 py-2 text-left text-sm hover:bg-slate-50 {attendants.includes(member.userId) ? 'bg-primary-50 text-primary-700' : ''}"
								>
									<input
										type="checkbox"
										checked={attendants.includes(member.userId)}
										readonly
										class="rounded border-slate-300"
									/>
									{member.firstName} {member.lastName}
								</button>
							{/each}
						</div>
					{/if}

					<!-- Non-user Attendant Input -->
					<div class="flex gap-2">
						<input
							type="text"
							bind:value={newAttendant}
							placeholder="Add non-user attendant..."
							class="flex-1 rounded-lg border border-slate-200 px-3 py-2 text-sm focus:border-primary-500 focus:outline-none"
						/>
						<button
							type="button"
							on:click={() => {
								if (newAttendant.trim()) {
									attendants = [...attendants, newAttendant.trim()];
									newAttendant = '';
								}
							}}
							class="rounded-lg bg-slate-100 px-3 py-2 text-sm hover:bg-slate-200"
						>
							Add
						</button>
					</div>

					<!-- Selected Attendants Chips -->
					{#if attendants.length > 0}
						<div class="mt-2 flex flex-wrap gap-1">
							{#each attendants as att}
								<span class="inline-flex items-center gap-1 rounded-full bg-primary-100 px-2 py-1 text-xs text-primary-700">
									{att}
									<button
										type="button"
										on:click={() => attendants = attendants.filter(a => a !== att)}
										class="ml-1 text-primary-500 hover:text-primary-700"
									>
										×
									</button>
								</span>
							{/each}
						</div>
					{/if}
				</div>
			</div>

			<!-- RSVP Info (Edit Mode Only) -->
			{#if isEditMode && rsvpData.length > 0}
				<div class="border-t border-slate-100 p-6">
					<h3 class="mb-3 text-sm font-semibold text-slate-700">RSVP Status</h3>

					<!-- Going -->
					{#if rsvpData.filter(r => r.status === 'going').length > 0}
						<div class="mb-2">
							<span class="text-xs font-medium text-green-700">Going ({rsvpData.filter(r => r.status === 'going').length}):</span>
							<div class="mt-1 flex flex-wrap gap-1">
								{#each rsvpData.filter(r => r.status === 'going') as rsvp}
									<span class="inline-flex items-center rounded-full bg-green-100 px-2 py-1 text-xs text-green-700">
										{rsvp.firstName || rsvp.userId}
									</span>
								{/each}
							</div>
						</div>
					{/if}

					<!-- Maybe -->
					{#if rsvpData.filter(r => r.status === 'maybe').length > 0}
						<div class="mb-2">
							<span class="text-xs font-medium text-yellow-700">Maybe ({rsvpData.filter(r => r.status === 'maybe').length}):</span>
							<div class="mt-1 flex flex-wrap gap-1">
								{#each rsvpData.filter(r => r.status === 'maybe') as rsvp}
									<span class="inline-flex items-center rounded-full bg-yellow-100 px-2 py-1 text-xs text-yellow-700">
										{rsvp.firstName || rsvp.userId}
									</span>
								{/each}
							</div>
						</div>
					{/if}

					<!-- Not Going -->
					{#if rsvpData.filter(r => r.status === 'declined' || r.status === 'not_going').length > 0}
						<div class="mb-2">
							<span class="text-xs font-medium text-red-700">Not Going ({rsvpData.filter(r => r.status === 'declined' || r.status === 'not_going').length}):</span>
							<div class="mt-1 flex flex-wrap gap-1">
								{#each rsvpData.filter(r => r.status === 'declined' || r.status === 'not_going') as rsvp}
									<span class="inline-flex items-center rounded-full bg-red-100 px-2 py-1 text-xs text-red-700">
										{rsvp.firstName || rsvp.userId}
									</span>
								{/each}
							</div>
						</div>
					{/if}
				</div>
			{/if}

			<!-- Actions -->
			<div class="flex items-center justify-end gap-3 border-t border-slate-100 p-6">
					{#if isEditMode}
						<button
							type="button"
							on:click={handleDelete}
							class="mr-auto rounded-lg px-4 py-2 text-sm font-medium text-red-600 hover:bg-red-50"
						>
							Delete
						</button>
					{/if}
					<button type="button" on:click={close} class="rounded-lg border border-slate-200 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50">
						Cancel
					</button>
					{#if showNlInput}
						<button type="button" on:click={clearDetected} class="rounded-lg border border-slate-200 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50">
							Clear
						</button>
					{/if}
					<button
						type="submit"
						class="rounded-lg bg-primary-600 px-4 py-2 text-sm font-medium text-white hover:bg-primary-700"
						disabled={!title || !start}
					>
						{isEditMode ? 'Update Event' : 'Create Event'}
					</button>
				</div>
			</form>
		</div>
	</div>
{/if}
