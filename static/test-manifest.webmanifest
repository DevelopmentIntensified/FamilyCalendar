{
	"name": "FamilyPlanz Test",
	"short_name": "FamilyPlanz T",
	"description": "A shared calendar for your family - events, RSVPs, and tasks in one place. (TEST environment - blue tile)",
	"start_url": "/calendar",
	"scope": "/",
	"display": "standalone",
	"background_color": "#ffffff",
	"theme_color": "#366d7e",
	"icons": [
		{
			"src": "/test-icon-192.png",
			"sizes": "192x192",
			"type": "image/png",
			"purpose": "any"
		},
		{
			"src": "/test-icon-512.png",
			"sizes": "512x512",
			"type": "image/png",
			"purpose": "any"
		},
		{
			"src": "/test-icon.svg",
			"sizes": "any",
			"type": "image/svg+xml",
			"purpose": "any"
		},
		{
			"src": "/brand/test-maskable-192.png",
			"sizes": "192x192",
			"type": "image/png",
			"purpose": "maskable"
		},
		{
			"src": "/brand/test-maskable-512.png",
			"sizes": "512x512",
			"type": "image/png",
			"purpose": "maskable"
		}
	],
	"share_target": {
		"action": "/calendar",
		"method": "GET",
		"params": {
			"title": "title",
			"text": "text",
			"url": "url"
		}
	}
}
